@echo off
rem ====================================================================
rem check_pendings.bat
rem Скрипт-обертка для запуска проверки полей со статусом 'pending'.
rem Принимает один аргумент: путь к проверяемому файлу (например, primary.md).
rem ====================================================================

setlocal

rem Проверяем, передан ли аргумент (путь к файлу)
if "%~1"=="" (
    echo [ERROR] Не указан файл для проверки.
    echo Использование: %~nx0 ^<путь_к_файлу^>
    exit /b 1
)

rem Определяем путь к каталогу, где лежит этот bat-файл,
rem чтобы вызвать ps1-скрипт из той же папки.
set "SCRIPT_DIR=%~dp0"

rem Запуск PowerShell-скрипта с обходом политики выполнения
powershell -NoProfile -ExecutionPolicy Bypass -File "%SCRIPT_DIR%check_pendings.ps1" "%~1"

rem Возвращаем код выхода, полученный от PowerShell
exit /b %errorlevel%
