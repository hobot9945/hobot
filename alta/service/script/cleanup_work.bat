@echo off
chcp 65001 >nul
REM ============================================================
REM Очистка рабочего каталога alta\work
REM Удаляет всё содержимое (файлы и подкаталоги),
REM сам каталог work остаётся на месте.
REM Путь захардкожен относительно корня проекта hobot.
REM ============================================================

REM Переходим в корень проекта (каталог, где лежит этот скрипт, или фиксированный путь)
cd /d "C:\Users\su144\RustroverProjects\rustdev\hobot"

REM Целевой каталог
set "WORK_DIR=alta\work"

REM Проверка, что каталог существует
if not exist "%WORK_DIR%\" (
    echo [!] Каталог %WORK_DIR% не найден. Создаю...
    md "%WORK_DIR%"
    goto :end
)

REM Удаляем все файлы в корне work (/Q — тихо, /F — принудительно, /A — все атрибуты)
del /Q /F /A "%WORK_DIR%\*" 2>nul

REM Удаляем все подкаталоги внутри work
for /d %%D in ("%WORK_DIR%\*") do rd /S /Q "%%D"

:end
echo [OK] %WORK_DIR% очищен.